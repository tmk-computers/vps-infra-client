# ==============================================================================
# ☕ PRODUCTION DOCKERFILE: SPRING BOOT (JAVA 21)
# Multi-stage optimized build for high performance & minimal image footprint
# ==============================================================================

# Stage 1: Build JAR with Maven
FROM maven:3.9-eclipse-temurin-21-alpine AS builder
WORKDIR /build

# Cache dependencies
COPY pom.xml ./
RUN mvn dependency:go-offline -B

# Compile and package application (skip tests in Docker packaging)
COPY src ./src
RUN mvn clean package -DskipTests -B

# Stage 2: Minimal Distroless / JRE Runtime
FROM eclipse-temurin:21-jre-alpine AS runtime
WORKDIR /app

# Create non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

# Copy executable fat JAR
COPY --from=builder /build/target/*.jar app.jar

ENV SERVER_PORT=8080
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC"

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
