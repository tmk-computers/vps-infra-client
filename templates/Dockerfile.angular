# ==============================================================================
# 🅰️ PRODUCTION DOCKERFILE: ANGULAR (18 / 19)
# Multi-stage Angular CLI compilation served with high-performance Nginx Alpine
# ==============================================================================

# Stage 1: Compile Angular App
FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build -- --configuration production

# Stage 2: Serve compiled browser bundle via Nginx
FROM nginx:stable-alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf

# Support both Angular 17+ (dist/project/browser) and legacy (dist/project)
COPY --from=builder /app/dist/*/browser /usr/share/nginx/html 2>/dev/null || \
     COPY --from=builder /app/dist/* /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
