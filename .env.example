# ==============================================================================
# 🚀 VPS-INFRA: ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ==========================================
# 1. ENTERPRISE LICENSING & SUBSCRIPTION
# ==========================================
# Provided by TMK Computers upon enterprise subscription onboarding.
TMK_LICENSE_KEY="eyJjbGllbnRJZCI6..."

# ==========================================
# 2. COMPANY & BRANDING CONFIGURATION
# ==========================================
COMPANY_NAME="Your Company Name"
PRIMARY_DOMAIN=yourdomain.com
ACME_SSL_EMAIL=admin@yourdomain.com

# ==========================================
# 2. CORE SUBDOMAINS & ROUTING
# ==========================================
DEVOPS_WEB_HOST=devops-manager.yourdomain.com
DEVOPS_API_HOST=devops-api.yourdomain.com
CI_WEB_HOST=ci.yourdomain.com
CI_API_HOST=ci-api.yourdomain.com
REGISTRY_HOST=registry.yourdomain.com
PGADMIN_HOST=pgadmin.yourdomain.com
PHPMYADMIN_HOST=phpmyadmin.yourdomain.com
TRAEFIK_DASHBOARD_HOST=traefik.yourdomain.com
TRAEFIK_BASIC_AUTH_USERS=admin:$$apr1$$RK4nxVWu$$rKs9Yi/0Bwl4lbhqhwRHU0

# Optional Container Image Release Tag Override (e.g. v2.1, uat, latest)
# Set to 'uat' when deploying on a remote QA/UAT test server
RELEASE_TAG=v2.1
# DEVOPS_API_IMAGE=ghcr.io/tmk-computers/tmk-devops-api:uat
# DEVOPS_WEB_IMAGE=ghcr.io/tmk-computers/tmk-devops-web:uat
# CI_API_IMAGE=ghcr.io/tmk-computers/tmk-ci-api:uat
# CI_WEB_IMAGE=ghcr.io/tmk-computers/tmk-ci-web:uat

# ==========================================
# 3. MULTI-DATABASE SUITE CONFIGURATION
# ==========================================
# A. PostgreSQL 16
POSTGRES_DB=devops_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=StrongPostgresPassword123!

# B. MariaDB 11.x / MySQL
MARIADB_DATABASE=master_mariadb
MARIADB_USER=mariadb_user
MARIADB_PASSWORD=StrongMariaDBPassword123!
MARIADB_ROOT_PASSWORD=StrongMariaDBRootPassword123!

# C. Microsoft SQL Server 2022
MSSQL_SA_PASSWORD=StrongSqlPassword123!
MSSQL_PID=Express

# D. Oracle Database 23ai Free
ORACLE_PASSWORD=StrongOraclePassword123!
ORACLE_APP_USER=devops_user
ORACLE_APP_PASSWORD=StrongOraclePassword123!
ORACLE_SERVICE=FREEPDB1

# E. MongoDB 7.0 LTS  (disabled by default — start with: ./db/manage-databases.sh start mongodb)
MONGO_ROOT_USER=mongo_admin
MONGO_ROOT_PASSWORD=StrongMongoPassword123!
MONGO_EXPRESS_HOST=mongo.yourdomain.com

# ==========================================
# 4. SUPERADMIN INITIAL CREDENTIALS
# ==========================================
SUPERADMIN_FULLNAME="System Administrator"
SUPERADMIN_EMAIL=admin@yourdomain.com
SUPERADMIN_PASSWORD=SuperAdminPassword123!

# ==========================================
# 5. JWT & SECURITY SECRET KEYS
# ==========================================
JWT_SECRET_KEY=generate_a_64_character_hex_string_here_5b5fea8f9a4b8f2c2e2c5b6f7
CI_JWT_SECRET=generate_a_64_character_hex_string_here_5b5fea8f9a4b8f2c2e2c5b6f7

# ==========================================
# 6. EMAIL & MAILGUN NOTIFICATIONS
# ==========================================
ENABLE_EMAIL_NOTIFICATIONS=false
EMAIL_PROVIDER=MailGun
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=mail.yourdomain.com
MAILGUN_FROM_EMAIL=notifications@mail.yourdomain.com
MAILGUN_FROM_NAME="DevOps Platform"
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mail.yourdomain.com
SMTP_PASS=your_smtp_password

# ==========================================
# 7. GOOGLE DRIVE BACKUP & OAUTH
# ==========================================
GOOGLE_DRIVE_AUTH_MODE=OAuth
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
GOOGLE_DRIVE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your_google_client_secret
GOOGLE_DRIVE_REFRESH_TOKEN=your_google_oauth_refresh_token

# ==========================================
# 8. DOCKER CONTAINER IMAGE REPOSITORY
# ==========================================
DEVOPS_API_IMAGE=ghcr.io/tmk-computers/tmk-devops-api:v2.1
DEVOPS_WEB_IMAGE=ghcr.io/tmk-computers/tmk-devops-web:v2.1
CI_API_IMAGE=ghcr.io/tmk-computers/tmk-ci-api:v2.1
CI_WEB_IMAGE=ghcr.io/tmk-computers/tmk-ci-web:v2.1
